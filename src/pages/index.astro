<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>That's a Bop!</title>
    <link href="https://fonts.googleapis.com/css2?family=Danfo&display=swap" rel="stylesheet">
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      body {
        background-color: #000000;
        height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: opacity 0.8s ease;
      }
      body.fade-out {
        opacity: 0;
      }
      a {
        font-family: 'Danfo', serif;
        font-size: 8rem;
        color: #fff;
        text-decoration: none;
        transition: opacity 0.3s;
      }
      a:hover {
        opacity: 0.7;
      }
    </style>
  </head>
  <body>
    <a href="/home" id="enter">That's a Bop!</a>

    <script>
      document.getElementById('enter').addEventListener('click', function(e) {
        e.preventDefault();
        document.body.classList.add('fade-out');
        setTimeout(() => {
          window.location.href = '/home';
        }, 800);
      });
    </script>
  </body>
</html>