<script>
  function toggleDetail(eventEl: HTMLElement) {
    const detail = eventEl.querySelector('.event-detail');
    if (!detail) return;
    const isOpen = detail.classList.contains('open');
    document.querySelectorAll('.event-detail.open').forEach(d => d.classList.remove('open'));
    if (!isOpen) detail.classList.add('open');
  }

  const filterBtns = document.querySelectorAll('.filter-btn');
  const sections = document.querySelectorAll('.decade-section');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const filter = (btn as HTMLElement).dataset.filter;
      sections.forEach(section => {
        if (filter === 'all' || (section as HTMLElement).dataset.decade === filter) {
          section.classList.remove('hidden');
        } else {
          section.classList.add('hidden');
        }
      });
    });
  });

  (window as any).toggleDetail = toggleDetail;
</script>