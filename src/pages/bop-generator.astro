---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Bop Generator 3000">
  <link href="https://fonts.googleapis.com/css2?family=Boogaloo&family=Nunito:wght@400;700&display=swap" rel="stylesheet">

  <section class="quiz-container">
    <h2 class="page-title">🎵 Bop Generator 3000 🎵</h2>
    <p class="quiz-subtitle">Answer 10 questions. Receive your bop.</p>

    <div id="quiz">
      <div id="question-container">
        <p id="question-number" class="question-number">Question 1 of 10</p>
        <h3 id="question-text" class="question-text"></h3>
        <div id="options" class="options"></div>
      </div>

      <div id="result-container" class="result-container" style="display:none;">
        <p class="result-label">✨ The Bop Generator 3000 has spoken ✨</p>
        <img
          src="https://upload.wikimedia.org/wikipedia/en/1/1c/PhilosophyoftheWorld.jpg"
          alt="Philosophy of the World cover"
          class="result-cover"
        />
        <h3 class="result-title">Philosophy of the World</h3>
        <p class="result-artist">The Shaggs · 1969</p>
        <p class="result-text">
          No matter who you are, where you stand politically, what you think of the Catholic Church,
          or your position on the holographic bound imposed by the Bekenstein-Hawking entropy formula —
          the universe has determined that your bop is <em>Philosophy of the World</em> by The Shaggs.
          Congratulations. You have been chosen.
        </p>
        <button id="restart-btn" class="restart-btn">Try Again 🔁</button>
      </div>
    </div>
  </section>
</Layout>

<style>
  .quiz-container {
    max-width: 720px;
    margin: 0 auto;
    font-family: 'Nunito', sans-serif;
  }

  .page-title {
    font-family: 'Boogaloo', cursive;
    font-size: 3.5rem;
    color: #e84393;
    text-align: center;
    margin-bottom: 10px;
    letter-spacing: 0.02em;
  }

  .quiz-subtitle {
    text-align: center;
    font-size: 1.1rem;
    color: #888;
    margin-bottom: 50px;
  }

  .question-number {
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #e84393;
    margin-bottom: 16px;
    font-weight: 700;
  }

  .question-text {
    font-family: 'Boogaloo', cursive;
    font-size: 2.2rem;
    margin-bottom: 36px;
    line-height: 1.3;
    color: #1a1a1a;
  }

  .options {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .option-btn {
    background: #fff;
    border: 2px solid #e84393;
    border-radius: 12px;
    padding: 16px 24px;
    font-family: 'Nunito', sans-serif;
    font-size: 1.1rem;
    font-weight: 700;
    color: #e84393;
    cursor: pointer;
    text-align: left;
    transition: background 0.15s, color 0.15s, transform 0.1s;
  }

  .option-btn:hover {
    background: #e84393;
    color: #fff;
    transform: translateX(6px);
  }

  .result-container {
    text-align: center;
    padding: 20px 0;
  }

  .result-label {
    font-family: 'Boogaloo', cursive;
    font-size: 1.8rem;
    color: #e84393;
    margin-bottom: 30px;
  }

  .result-cover {
    width: 240px;
    height: 240px;
    object-fit: cover;
    margin-bottom: 24px;
    border-radius: 8px;
    box-shadow: 0 8px 30px rgba(232, 67, 147, 0.3);
  }

  .result-title {
    font-family: 'Boogaloo', cursive;
    font-size: 2.4rem;
    color: #1a1a1a;
    margin-bottom: 8px;
  }

  .result-artist {
    font-size: 0.9rem;
    color: #aaa;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 24px;
    font-weight: 700;
  }

  .result-text {
    font-size: 1.05rem;
    color: #444;
    line-height: 1.8;
    margin-bottom: 36px;
  }

  .restart-btn {
    background: #e84393;
    border: none;
    border-radius: 12px;
    padding: 14px 36px;
    font-family: 'Nunito', sans-serif;
    font-size: 1rem;
    font-weight: 700;
    color: #fff;
    cursor: pointer;
    transition: background 0.15s, transform 0.1s;
  }

  .restart-btn:hover {
    background: #c0336f;
    transform: scale(1.05);
  }
</style>

<script>
  const questions = [
    {
      text: "What's the mood?",
      options: ["Down bad", "Up high"]
    },
    {
      text: "What is your political orientation?",
      options: ["Left", "Center", "Right"]
    },
    {
      text: "What should the tempo be like?",
      options: ["Fast", "Slow"]
    },
    {
      text: "What do you think of the Catholic Church?",
      options: ["Good", "Bad"]
    },
    {
      text: "What is your shoe size?",
      options: ["<36", "36–40", "40–45", "Sasquatch"]
    },
    {
      text: "What are you like?",
      options: ["Introvert", "Extrovert"]
    },
    {
      text: "Where do you stand on whether the holographic bound imposed by the Bekenstein-Hawking entropy formula implies that bulk spacetime degrees of freedom are fundamentally redundant in any UV-complete theory of quantum gravity?",
      options: [
        "AdS/CFT makes this unambiguous — the bulk is the redundancy, not the boundary.",
        "Holography is a property of specific backgrounds, not a universal ontological claim about spacetime itself."
      ]
    },
    {
      text: "What do you like more?",
      options: ["City", "Countryside"]
    },
    {
      text: "What are you more like?",
      options: ["Creative & unconventional", "Logical & formulaic"]
    },
    {
      text: "What do you consider yourself?",
      options: ["Unique", "Generic"]
    }
  ];

  let current = 0;

  const questionNumber = document.getElementById('question-number');
  const questionText = document.getElementById('question-text');
  const optionsContainer = document.getElementById('options');
  const questionContainer = document.getElementById('question-container');
  const resultContainer = document.getElementById('result-container');
  const restartBtn = document.getElementById('restart-btn');

  function showQuestion(index) {
    const q = questions[index];
    questionNumber.textContent = `Question ${index + 1} of ${questions.length}`;
    questionText.textContent = q.text;
    questionText.style.fontSize = (index === 6) ? '1.1rem' : '2.2rem';
    optionsContainer.innerHTML = '';
    q.options.forEach(option => {
      const btn = document.createElement('button');
      btn.className = 'option-btn';
      btn.textContent = option;
      btn.addEventListener('click', () => nextQuestion());
      optionsContainer.appendChild(btn);
    });
  }

  function nextQuestion() {
    current++;
    if (current < questions.length) {
      showQuestion(current);
    } else {
      showResult();
    }
  }

  function showResult() {
    questionContainer.style.display = 'none';
    resultContainer.style.display = 'block';
  }

  restartBtn.addEventListener('click', () => {
    current = 0;
    resultContainer.style.display = 'none';
    questionContainer.style.display = 'block';
    showQuestion(0);
  });

  showQuestion(0);
</script>
