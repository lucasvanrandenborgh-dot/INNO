---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Bop Generator 3000">
  <link href="https://fonts.googleapis.com/css2?family=Boogaloo&family=Nunito:wght@400;700&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Boogaloo&family=Nunito:wght@400;700&family=Chicle&display=swap" rel="stylesheet">
  <section class="quiz-container">
    <h2 class="page-title"> Bop Generator 3000 </h2>
    <p class="quiz-subtitle">Answer 10 questions. Receive your bop.</p>

    <div id="quiz">
      <div id="question-container">
        <p id="question-number" class="question-number">Question 1 of 10</p>
        <h3 id="question-text" class="question-text"></h3>
        <div id="options" class="options"></div>
      </div>

      <div id="result-container" class="result-container" style="display:none;">
        <p class="result-label"> The Bop Generator 3000 has spoken </p>
        <img
          src="https://m.media-amazon.com/images/I/71tghcDDIaL._UF894,1000_QL80_.jpg"
          alt="Philosophy of the World cover"
          class="result-cover"
        />
        <h3 class="result-title">Philosophy of the World</h3>
        <p class="result-artist">The Shaggs · 1969</p>
        <p class="result-text">
          No matter who you are, where you stand politically, what you think of the Catholic Church,
          or your position on the holographic bound imposed by the Bekenstein-Hawking entropy formula —
          the universe has determined that your bop is <em>Philosophy of the World</em> by The Shaggs.
          Congratulations. You have been chosen.
        </p>
        <button id="restart-btn" class="restart-btn">Try Again</button>
      </div>
    </div>
  </section>
</Layout>

<style is: global>
  .quiz-container {
    max-width: 720px;
    margin: 0 auto;
    font-family: 'Chicle', sans-serif;
  }
body {
    background-image: url('/bop-bg.jpg');
    background-size: cover;
    background-position: center;
    background-attachment: fixed;
    background-size: 100%;
}
  .page-title {
    font-family: 'Danfo', serif;
    font-size: 5.0rem;
    color: #ffffff;
    text-align: center;
    margin-bottom: 10px;
    letter-spacing: 0.02em;
  }

  .quiz-subtitle {
    font-family: 'Danfo', serif;
    text-align: center;
    font-size: 2.5rem;
    color: #ffffff;
    margin-bottom: 50px;
  }

  .question-number {
    font-size: 2.0rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #ffffff;
    margin-bottom: 16px;
    font-weight: 700;
  }

  .question-text {
    font-family: 'Chicle', cursive;
    font-size: 2.5rem;
    margin-bottom: 36px;
    line-height: 1.3;
    color: #ffffff;
  }

  .options {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .option-btn {
    background: #fff;
    border: 2px solid #000000;
    border-radius: 12px;
    padding: 30px 40px;
    font-family: 'Chicle', sans-serif;
    font-size: 2.0rem;
    font-weight: 700;
    color: #000000;
    cursor: pointer;
    text-align: left;
    transition: background 0.15s, color 0.15s, transform 0.1s;
  }

  .option-btn:hover {
    background: #1b5c28;
    color: #fff;
    transform: translateX(6px);
  }

  .result-container {
    text-align: center;
    padding: 20px 0;
  }

  .result-label {
    font-family: 'Chicle', cursive;
    font-size: 1.8rem;
    color: #ffffff;
    margin-bottom: 30px;
  }

  .result-cover {
    width: 240px;
    height: 240px;
    object-fit: cover;
    margin-bottom: 24px;
    border-radius: 8px;
    box-shadow: 0 8px 30px rgba(15, 87, 45, 0.3);
  }

  .result-title {
    font-family: 'Chicle', cursive;
    font-size: 2.4rem;
    color: #ffffff;
    margin-bottom: 8px;
  }

  .result-artist {
    font-size: 1.5rem;
    color: #ffffff;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 24px;
    font-weight: 700;
  }

  .result-text {
    font-size: 2.0rem;
    color: #ffffff;
    line-height: 2.0;
    margin-bottom: 36px;
  }

  .restart-btn {
    background: #1b5c28;
    border: none;
    border-radius: 12px;
    padding: 14px 36px;
    font-family: 'Danfo', sans-serif;
    font-size: 2.0rem;
    font-weight: 700;
    color: #fff;
    cursor: pointer;
    transition: background 0.15s, transform 0.1s;
  }

  .restart-btn:hover {
    background: #c0336f;
    transform: scale(1.05);
  }
</style>

<script>
  const questions = [
  { text: "What's the mood?", options: ["Down bad", "Up high"] },
  { text: "What is your political orientation?", options: ["Left", "Center", "Right"] },
  { text: "What should the tempo be like?", options: ["Fast", "Slow"] },
  { text: "What do you think of the Catholic Church?", options: ["Good", "Bad"] },
  { text: "What is your shoe size?", options: ["<36", "36–40", "41–45", "Sasquatch"] },
  { text: "What are you like?", options: ["Introvert", "Extrovert"] },
  { text: "Where do you stand on whether the holographic bound imposed by the Bekenstein-Hawking entropy formula implies that bulk spacetime degrees of freedom are fundamentally redundant in any UV-complete theory of quantum gravity?", options: ["AdS/CFT makes this unambiguous — the bulk is the redundancy, not the boundary.", "Holography is a property of specific backgrounds, not a universal ontological claim about spacetime itself."] },
  { text: "What do you like more?", options: ["City", "Country-side"] },
  { text: "What are you more like?", options: ["Creative & unconventional", "Logical & formulaic"] },
  { text: "What do you consider yourself?", options: ["Unique", "Generic"] }
];

let current = 0;
const answers = [];

const questionNumber = document.getElementById('question-number');
const questionText = document.getElementById('question-text');
const optionsContainer = document.getElementById('options');
const questionContainer = document.getElementById('question-container');
const resultContainer = document.getElementById('result-container');

function showQuestion(index) {
  const q = questions[index];
  questionNumber.textContent = `Question ${index + 1} of ${questions.length}`;
  questionText.textContent = q.text;
  questionText.style.fontSize = (index === 6) ? '2.0rem' : '2.2rem';
  optionsContainer.innerHTML = '';
  q.options.forEach(option => {
    const btn = document.createElement('button');
    btn.className = 'option-btn';
    btn.textContent = option;
    btn.addEventListener('click', () => nextQuestion(option));
    optionsContainer.appendChild(btn);
  });
}

function nextQuestion(selectedAnswer) {
  answers.push(selectedAnswer);
  current++;
  if (current < questions.length) {
    showQuestion(current);
  } else {
    showResult();
  }
}

async function showResult() {
  questionContainer.style.display = 'none';
  resultContainer.style.display = 'block';
  resultContainer.innerHTML = `<p class="result-label">The Bop Generator 3000 is consulting the oracle...</p>`;

  const apiKey = 'AIzaSyA5LV8MEhCRq1n4QXlREE1un3CcL5nz3IQ';

  const prompt = `Based on these quiz answers, recommend a real album that fits this person's vibe. Be creative — pick something genuine but potentially unexpected.

Quiz answers:
1. Mood: ${answers[0]}
2. Political orientation: ${answers[1]}
3. Preferred tempo: ${answers[2]}
4. View on the Catholic Church: ${answers[3]}
5. Shoe size: ${answers[4]}
6. Personality: ${answers[5]}
7. Quantum gravity stance: ${answers[6]}
8. City or countryside: ${answers[7]}
9. Self-description: ${answers[8]}
10. Unique or generic: ${answers[9]}

Respond ONLY with a JSON object, no extra text:
{
  "albumTitle": "...",
  "artist": "...",
  "year": "...",
  "description": "2-3 sentences. Quirky, funny, slightly absurdist. Written like an oracle who takes this quiz extremely seriously."
}`;

  try {
    const response = await fetch(
      `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent?key=${apiKey}`,
      {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ contents: [{ parts: [{ text: prompt }] }] }),
      }
    );

    const data = await response.json();
    const text = data.candidates[0].content.parts[0].text;
    const jsonMatch = text.match(/\{[\s\S]*\}/);
    const result = JSON.parse(jsonMatch[0]);

    let coverUrl = '';
    try {
      const itunes = await fetch(`https://itunes.apple.com/search?term=${encodeURIComponent(result.artist + ' ' + result.albumTitle)}&entity=album&limit=1`);
      const itunesData = await itunes.json();
      if (itunesData.results?.length > 0) {
        coverUrl = itunesData.results[0].artworkUrl100.replace('100x100bb', '600x600bb');
      }
    } catch (e) {}

    resultContainer.innerHTML = `
      <p class="result-label">The Bop Generator 3000 has spoken</p>
      ${coverUrl ? `<img src="${coverUrl}" alt="${result.albumTitle} cover" class="result-cover" />` : ''}
      <h3 class="result-title">${result.albumTitle}</h3>
      <p class="result-artist">${result.artist} · ${result.year}</p>
      <p class="result-text">${result.description}</p>
      <button id="restart-btn" class="restart-btn">Try Again</button>
    `;
    document.getElementById('restart-btn').addEventListener('click', restart);
  } catch (e) {
    resultContainer.innerHTML = `
      <p class="result-label">The oracle is silent. Try again.</p>
      <button id="restart-btn" class="restart-btn">Try Again</button>
    `;
    document.getElementById('restart-btn').addEventListener('click', restart);
  }
}

function restart() {
  current = 0;
  answers.length = 0;
  resultContainer.style.display = 'none';
  questionContainer.style.display = 'block';
  showQuestion(0);
}

showQuestion(0);
</script>
